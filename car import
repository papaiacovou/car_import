import streamlit as st
import requests
import xml.etree.ElementTree as ET
import json
import os

# ---------------- CONFIG ----------------
ADMIN_PASSWORD = "i4ipapa"
CONFIG_FILE = "tax_config.json"

DEFAULT_CONFIG = {
    "vat_uk_percent": 20.0,
    "duty_percent": 10.0,
    "vat_cy_percent": 19.0,
    "mot": 60.0,
    "plates": 40.0
}

if not os.path.exists(CONFIG_FILE):
    with open(CONFIG_FILE, "w") as f:
        json.dump(DEFAULT_CONFIG, f, indent=2)

def load_config():
    with open(CONFIG_FILE) as f:
        return json.load(f)

def save_config(cfg):
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

cfg = load_config()

# ---------------- TOM ----------------
TOM_BY_WEIGHT = [
    (0, 2000, 180),
    (2001, 2300, 220),
    (2301, 2500, 260),
    (2501, 2700, 300),
    (2701, 2900, 340),
    (2901, 3100, 380),
    (3101, 3300, 450),
    (3301, 3500, 550),
]

def tom(weight):
    for a, b, fee in TOM_BY_WEIGHT:
        if a <= weight <= b:
            return fee
    return 0

# ---------------- FX ----------------
@st.cache_data(ttl=3600)
def gbp_to_eur():
    try:
        xml = requests.get(
            "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml",
            timeout=5
        ).content
        root = ET.fromstring(xml)
        ns = {"e": "http://www.ecb.int/vocabulary/2002-08-01/eurofxref"}
        date = root.find(".//e:Cube[@time]", ns).attrib["time"]
        rate = float(root.find(".//e:Cube[@currency='GBP']", ns).attrib["rate"])
        return round(1 / rate, 4), date
    except:
        return 1.15, "fallback"

rate, rate_date = gbp_to_eur()

# ---------------- UI ----------------
st.set_page_config(page_title="Car Import Calculator", layout="centered")
st.title("🚗 Car Import Calculator")

tab_uk, tab_jp, tab_admin = st.tabs([
    "🇬🇧 UK Import",
    "🇯🇵 Japan Import",
    "⚙️ Admin"
])

# ---------------- UK ----------------
with tab_uk:
    st.caption(f"GBP → EUR: {rate} (ECB {rate_date})")

    p = st.number_input("Purchase price (£)", 0.0)
    t = st.number_input("Transport (£)", 0.0)
    i = st.number_input("Insurance (€)", 0.0)
    w = st.number_input("Vehicle weight (kg)", 0)

    if st.button("Calculate UK Import"):
        uk_vat = p * cfg["vat_uk_percent"] / 100
        cif = (p + uk_vat) * rate + t * rate + i
        duty = cif * cfg["duty_percent"] / 100
        vat = (cif + duty) * cfg["vat_cy_percent"] / 100
        total = cif + duty + vat + cfg["mot"] + cfg["plates"] + tom(w)

        st.success(f"Final total: €{total:,.2f}")

# ---------------- JAPAN ----------------
with tab_jp:
    p = st.number_input("Purchase price (€)", 0.0)
    s = st.number_input("Shipping (€)", 0.0)
    w = st.number_input("Vehicle weight (kg)", 0)

    if st.button("Calculate Japan Import"):
        cif = p + s
        duty = cif * cfg["duty_percent"] / 100
        vat = (cif + duty) * cfg["vat_cy_percent"] / 100
        total = cif + duty + vat + cfg["mot"] + cfg["plates"] + tom(w)

        st.success(f"Final total: €{total:,.2f}")

# ---------------- ADMIN ----------------
with tab_admin:
    st.subheader("Admin settings")

    pwd = st.text_input("Password", type="password")

    if pwd == ADMIN_PASSWORD:
        cfg["vat_uk_percent"] = st.number_input("UK VAT %", value=cfg["vat_uk_percent"])
        cfg["duty_percent"] = st.number_input("Duty %", value=cfg["duty_percent"])
        cfg["vat_cy_percent"] = st.number_input("Cyprus VAT %", value=cfg["vat_cy_percent"])
        cfg["mot"] = st.number_input("MOT €", value=cfg["mot"])
        cfg["plates"] = st.number_input("Plates €", value=cfg["plates"])

        if st.button("Save"):
            save_config(cfg)
            st.success("Saved. Refresh page.")
    else:
        st.warning("Enter admin password")
